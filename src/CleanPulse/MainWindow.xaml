<Window x:Class="CleanPulse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CleanPulse.Localization"
        xmlns:vm="clr-namespace:CleanPulse.ViewModels"
        Title="CleanPulse"
        Width="1180"
        Height="760"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico"
        Background="{DynamicResource WindowBgBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Sidebar -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBgBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,1,0"
                Padding="16,20">
            <DockPanel LastChildFill="True">

                <!-- Brand Header -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,22">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource AccentBrush}" Margin="0,0,12,0">
                        <Path Data="M 5,19 L 11,19 L 15,8 L 19,28 L 24,15 L 27,19 L 33,19"
                              Stroke="#FFFFFF"
                              StrokeThickness="2.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding [app_name], Source={x:Static loc:Loc.Instance}}"
                                   FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="{Binding [app_tagline], Source={x:Static loc:Loc.Instance}}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Bottom Sidebar Cards -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <!-- Primary Drive Usage Card -->
                    <Border Style="{StaticResource CardBorderStyle}"
                            Background="{DynamicResource CardElevatedBgBrush}"
                            Padding="12"
                            Margin="0,0,0,10"
                            DataContext="{Binding PrimaryDrive}"
                            Visibility="{Binding Converter={StaticResource NullToVis}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="{Binding [drive_system_disk], Source={x:Static loc:Loc.Instance}}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding DriveName}"
                                           HorizontalAlignment="Right"
                                           FontWeight="SemiBold"
                                           FontSize="12"/>
                            </Grid>
                            <ProgressBar Style="{StaticResource ModernProgressBarStyle}"
                                         Maximum="100"
                                         Value="{Binding UsedPercentage, Mode=OneWay}"
                                         Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding FreeSummaryText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <!-- Privilege / Elevation Status -->
                    <Border Style="{StaticResource CardBorderStyle}"
                            Background="{DynamicResource CardElevatedBgBrush}"
                            Padding="12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource WarningFgBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAdministrator}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource SuccessFgBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding PrivilegeStatusText}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="{Binding [privilege_elevate_hint], Source={x:Static loc:Loc.Instance}}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding IsStandardUser, Converter={StaticResource BoolToVis}}"
                                       Margin="0,2,0,8"/>
                            <Button Content="{Binding [privilege_elevate], Source={x:Static loc:Loc.Instance}}"
                                    Command="{Binding RestartAsAdminCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="10,6"
                                    FontSize="12"
                                    Visibility="{Binding IsStandardUser, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Navigation Buttons -->
                <StackPanel VerticalAlignment="Top">
                    <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                 GroupName="MainNav"
                                 IsChecked="{Binding ActiveSection, Converter={StaticResource EnumEqBool}, ConverterParameter=Cleaner}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 12,2 L 15,9 L 22,12 L 15,15 L 12,22 L 9,15 L 2,12 L 9,9 Z"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding [nav_cleaner], Source={x:Static loc:Loc.Instance}}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                 GroupName="MainNav"
                                 IsChecked="{Binding ActiveSection, Converter={StaticResource EnumEqBool}, ConverterParameter=Logs}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 4,5 H 20 M 4,12 H 20 M 4,19 H 14"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding [nav_logs], Source={x:Static loc:Loc.Instance}}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                 GroupName="MainNav"
                                 IsChecked="{Binding ActiveSection, Converter={StaticResource EnumEqBool}, ConverterParameter=Exclusions}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 12,2 L 20,6 V 12 C 20,17 16.5,20.5 12,22 C 7.5,20.5 4,17 4,12 V 6 Z"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.8"
                                  Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding [nav_exclusions], Source={x:Static loc:Loc.Instance}}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                 GroupName="MainNav"
                                 IsChecked="{Binding ActiveSection, Converter={StaticResource EnumEqBool}, ConverterParameter=Settings}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 12,8 A 4,4 0 1 0 12,16 A 4,4 0 1 0 12,8 Z M 19.4,15 A 1.65,1.65 0 0 0 19.7,16.8 L 19.8,16.9 A 2,2 0 0 1 17,19.7 L 16.9,19.6 A 1.65,1.65 0 0 0 15,19.9 A 1.65,1.65 0 0 0 14,21.4 V 21.6 A 2,2 0 0 1 10,21.6 V 21.4 A 1.65,1.65 0 0 0 9,19.9 A 1.65,1.65 0 0 0 7.2,19.6 L 7.1,19.7 A 2,2 0 0 1 4.3,16.9 L 4.4,16.8 A 1.65,1.65 0 0 0 4.1,15 A 1.65,1.65 0 0 0 2.6,14 H 2.4 A 2,2 0 0 1 2.4,10 H 2.6 A 1.65,1.65 0 0 0 4.1,9 A 1.65,1.65 0 0 0 4.4,7.2 L 4.3,7.1 A 2,2 0 0 1 7.1,4.3 L 7.2,4.4 A 1.65,1.65 0 0 0 9,4.1 A 1.65,1.65 0 0 0 10,2.6 V 2.4 A 2,2 0 0 1 14,2.4 V 2.6 A 1.65,1.65 0 0 0 15,4.1 A 1.65,1.65 0 0 0 16.8,4.4 L 16.9,4.3 A 2,2 0 0 1 19.7,7.1 L 19.6,7.2 A 1.65,1.65 0 0 0 19.9,9 A 1.65,1.65 0 0 0 21.4,10 H 21.6 A 2,2 0 0 1 21.6,14 H 21.4 A 1.65,1.65 0 0 0 19.9,15 Z"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.7"
                                  Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding [nav_settings], Source={x:Static loc:Loc.Instance}}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Workspace Content -->
        <Grid Grid.Column="1" Margin="22,20">

            <!-- SECTION 1: CLEANER -->
            <Grid Visibility="{Binding ActiveSection, Converter={StaticResource EnumEqVis}, ConverterParameter=Cleaner}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Hero Action Card -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="20,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{Binding HeroTitle}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding HeroSubtitle}"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{Binding [btn_analyze], Source={x:Static loc:Loc.Instance}}"
                                        Command="{Binding AnalyzeCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,10,0"/>
                                <Button Content="{Binding [btn_clean], Source={x:Static loc:Loc.Instance}}"
                                        Command="{Binding CleanCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"/>
                                <Button Content="{Binding [btn_cancel], Source={x:Static loc:Loc.Instance}}"
                                        Command="{Binding CancelCommand}"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                        Margin="10,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Progress & Active Path -->
                        <StackPanel Grid.Row="1"
                                    Margin="0,14,0,0"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                            <ProgressBar Style="{StaticResource ModernProgressBarStyle}"
                                         Maximum="100"
                                         Value="{Binding ProgressPercent, Mode=OneWay}"/>
                            <TextBlock Text="{Binding CurrentScanPath}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,6,0,0"/>
                        </StackPanel>

                        <!-- Quick Selection Presets -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="{Binding [btn_select_recommended], Source={x:Static loc:Loc.Instance}}"
                                    Command="{Binding SelectRecommendedCommand}"
                                    Style="{StaticResource ChipButtonStyle}"
                                    Margin="0,0,8,0"/>
                            <Button Content="{Binding [btn_select_all], Source={x:Static loc:Loc.Instance}}"
                                    Command="{Binding SelectAllCommand}"
                                    Style="{StaticResource ChipButtonStyle}"
                                    Margin="0,0,8,0"/>
                            <Button Content="{Binding [btn_select_none], Source={x:Static loc:Loc.Instance}}"
                                    Command="{Binding SelectNoneCommand}"
                                    Style="{StaticResource ChipButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Split Categories + File Inspector -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*" MinWidth="360"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*" MinWidth="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Grouped Categories List -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="8">
                        <ListBox ItemsSource="{Binding CategoriesView}"
                                 SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Margin="10,10,10,4"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Margin" Value="2"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="RowBd"
                                                        Background="Transparent"
                                                        BorderBrush="Transparent"
                                                        BorderThickness="1"
                                                        CornerRadius="9"
                                                        Padding="10,9">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="RowBd" Property="Background" Value="{DynamicResource CardHoverBgBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="RowBd" Property="Background" Value="{DynamicResource CardSelectedBgBrush}"/>
                                                        <Setter TargetName="RowBd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CategoryItemViewModel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  Style="{StaticResource ModernCheckBoxStyle}"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,4,0"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="13.5"
                                                           FontWeight="SemiBold"/>
                                                <Border Background="{DynamicResource WarningBgBrush}"
                                                        CornerRadius="4"
                                                        Padding="6,1"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding ShowAdminBadge, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding [badge_admin], Source={x:Static loc:Loc.Instance}}"
                                                               FontSize="10.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource WarningFgBrush}"/>
                                                </Border>
                                                <Border Background="{DynamicResource SecondarySoftBrush}"
                                                        CornerRadius="4"
                                                        Padding="6,1"
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsCaution, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding [badge_caution], Source={x:Static loc:Loc.Instance}}"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource SecondaryAccentBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SizeText}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCleaned}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessFgBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsAccessDenied}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerFgBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsAnalyzedWithItems}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource SecondaryAccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding FileCountText}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- Right: Selected Category Inspector -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16">
                        <Grid DataContext="{Binding SelectedCategory}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <StackPanel Grid.Row="0" Visibility="{Binding Converter={StaticResource NullToVis}}">
                                <Grid>
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"/>
                                    <Border Background="{DynamicResource CardElevatedBgBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,3"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                </Grid>

                                <Border Background="{DynamicResource AccentSoftBrush}"
                                        CornerRadius="8"
                                        Padding="10,8"
                                        Margin="0,10,0,10">
                                    <TextBlock Text="{Binding SafetyNote}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>

                            <!-- Target Paths -->
                            <StackPanel Grid.Row="1" Margin="0,0,0,10" Visibility="{Binding Converter={StaticResource NullToVis}}">
                                <TextBlock Text="{Binding [inspector_targets], Source={x:Static loc:Loc.Instance}}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,0,0,4"/>
                                <Border Background="{DynamicResource CardElevatedBgBrush}"
                                        CornerRadius="8"
                                        Padding="10,7">
                                    <TextBlock Text="{Binding TargetPathsText}"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>

                            <!-- Discovered Files List -->
                            <Grid Grid.Row="2" Visibility="{Binding Converter={StaticResource NullToVis}}">
                                <ListBox ItemsSource="{Binding PreviewItems}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="6,5"/>
                                            <Setter Property="Margin" Value="0,1"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Bd"
                                                                Background="Transparent"
                                                                CornerRadius="6"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBgBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ScannedItemViewModel}">
                                            <Grid ToolTip="{Binding FullPath}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="12.5"
                                                               FontWeight="Medium"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding FullPath}"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding SizeText}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding ModifiedText}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               HorizontalAlignment="Right"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding IsSpecialAction, Converter={StaticResource InvBoolToVis}}">
                                                    <Button Content="📁"
                                                            ToolTip="{Binding [inspector_open_folder], Source={x:Static loc:Loc.Instance}}"
                                                            Command="{Binding DataContext.OpenItemFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource ChipButtonStyle}"
                                                            Padding="6,2"
                                                            Margin="0,0,4,0"/>
                                                    <Button Content="✕"
                                                            ToolTip="{Binding [inspector_add_exclusion], Source={x:Static loc:Loc.Instance}}"
                                                            Command="{Binding DataContext.ExcludeItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource ChipButtonStyle}"
                                                            Padding="6,2"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Empty items hint -->
                                <TextBlock Text="{Binding [inspector_no_files], Source={x:Static loc:Loc.Instance}}"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Margin="16">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PreviewItems.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <TextBlock Grid.Row="3"
                                       Text="{Binding TruncatedNoticeText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding ShowTruncatedNotice, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- SECTION 2: LOGS / HISTORY -->
            <Grid Visibility="{Binding ActiveSection, Converter={StaticResource EnumEqVis}, ConverterParameter=Logs}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel>
                        <TextBlock Text="{Binding [logs_title], Source={x:Static loc:Loc.Instance}}"
                                   FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="{Binding LogsSubtitleText}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="{Binding [logs_export], Source={x:Static loc:Loc.Instance}}"
                                Command="{Binding ExportLogsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,10,0"/>
                        <Button Content="{Binding [logs_clear], Source={x:Static loc:Loc.Instance}}"
                                Command="{Binding ClearLogsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="14">
                    <Grid>
                        <ListView ItemsSource="{Binding HistoryRows}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="10,9"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border Background="{DynamicResource CardElevatedBgBrush}"
                                                        CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:HistoryRowViewModel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="155"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding TimestampText}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>

                                        <Border Grid.Column="1"
                                                CornerRadius="5"
                                                Padding="8,3"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource SecondarySoftBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCleanAction}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding ActionLabel}" FontSize="12" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryAccentBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCleanAction}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessFgBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding SizeText}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding FilesText}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding DurationText}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock Text="{Binding [logs_empty], Source={x:Static loc:Loc.Instance}}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasNoHistory, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- SECTION 3: EXCLUSIONS -->
            <Grid Visibility="{Binding ActiveSection, Converter={StaticResource EnumEqVis}, ConverterParameter=Exclusions}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="{Binding [excl_title], Source={x:Static loc:Loc.Instance}}"
                               FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="{Binding [excl_subtitle], Source={x:Static loc:Loc.Instance}}"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding NewExclusionInput, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding [excl_placeholder], Source={x:Static loc:Loc.Instance}}"
                                 Margin="0,0,10,0"/>
                        <Button Grid.Column="1"
                                Content="{Binding [excl_add], Source={x:Static loc:Loc.Instance}}"
                                Command="{Binding AddExclusionCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,10,0"/>
                        <Button Grid.Column="2"
                                Content="{Binding [excl_browse_folder], Source={x:Static loc:Loc.Instance}}"
                                Command="{Binding BrowseExclusionFolderCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" Padding="14">
                    <Grid>
                        <ListBox ItemsSource="{Binding Exclusions}"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Margin" Value="0,3"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="{DynamicResource CardElevatedBgBrush}"
                                                        CornerRadius="8"
                                                        Padding="12,9">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock Text="{Binding}"
                                                   FontFamily="Consolas"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"/>
                                        <Button Content="{Binding [excl_remove], Source={x:Static loc:Loc.Instance}}"
                                                Command="{Binding DataContext.RemoveExclusionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ChipButtonStyle}"
                                                HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="{Binding [excl_empty], Source={x:Static loc:Loc.Instance}}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasNoExclusions, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- SECTION 4: SETTINGS -->
            <ScrollViewer Visibility="{Binding ActiveSection, Converter={StaticResource EnumEqVis}, ConverterParameter=Settings}"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,6,0">
                    <TextBlock Text="{Binding [settings_title], Source={x:Static loc:Loc.Instance}}"
                               FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="{Binding [settings_subtitle], Source={x:Static loc:Loc.Instance}}"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,4,0,18"/>

                    <!-- Appearance & Language -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="18" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{Binding [settings_language], Source={x:Static loc:Loc.Instance}}"
                                           FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Русский"
                                                 IsChecked="{Binding IsRussian, Mode=TwoWay}"
                                                 Style="{StaticResource NavRadioButtonStyle}"
                                                 GroupName="LangGroup"
                                                 Margin="0,0,10,0"/>
                                    <RadioButton Content="English"
                                                 IsChecked="{Binding IsEnglish, Mode=TwoWay}"
                                                 Style="{StaticResource NavRadioButtonStyle}"
                                                 GroupName="LangGroup"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding [settings_theme], Source={x:Static loc:Loc.Instance}}"
                                           FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="{Binding [settings_theme_dark], Source={x:Static loc:Loc.Instance}}"
                                                 IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                                                 Style="{StaticResource NavRadioButtonStyle}"
                                                 GroupName="ThemeGroup"
                                                 Margin="0,0,10,0"/>
                                    <RadioButton Content="{Binding [settings_theme_light], Source={x:Static loc:Loc.Instance}}"
                                                 IsChecked="{Binding IsLightTheme, Mode=TwoWay}"
                                                 Style="{StaticResource NavRadioButtonStyle}"
                                                 GroupName="ThemeGroup"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Safety Thresholds -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{Binding [settings_min_age], Source={x:Static loc:Loc.Instance}}"
                                       FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding [settings_min_age_desc], Source={x:Static loc:Loc.Instance}}"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,4,0,10"/>
                            <ComboBox Style="{StaticResource ModernComboBoxStyle}"
                                      ItemsSource="{Binding AgeOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Hours"
                                      SelectedValue="{Binding MinimumFileAgeHours, Mode=TwoWay}"
                                      Width="320"
                                      HorizontalAlignment="Left"
                                      Margin="0,0,0,14"/>

                            <CheckBox Style="{StaticResource ModernCheckBoxStyle}"
                                      IsChecked="{Binding ConfirmBeforeClean, Mode=TwoWay}"
                                      Content="{Binding [settings_confirm_clean], Source={x:Static loc:Loc.Instance}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Local Drives Overview -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="18" Margin="0,0,0,14">
                        <ItemsControl ItemsSource="{Binding Drives}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DriveTileViewModel}">
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="210"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" FontWeight="SemiBold">
                                            <Run Text="{Binding DriveName, Mode=OneWay}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding VolumeLabel, Mode=OneWay}" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </TextBlock>
                                        <ProgressBar Grid.Column="1"
                                                     Style="{StaticResource ModernProgressBarStyle}"
                                                     Maximum="100"
                                                     Value="{Binding UsedPercentage, Mode=OneWay}"
                                                     VerticalAlignment="Center"
                                                     Margin="14,0"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding FreeSummaryText}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Security Guarantees & About -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{Binding [settings_security_title], Source={x:Static loc:Loc.Instance}}"
                                       FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding [settings_security_body], Source={x:Static loc:Loc.Instance}}"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="20"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="{Binding [settings_about_title], Source={x:Static loc:Loc.Instance}}"
                                       FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding [settings_about_body], Source={x:Static loc:Loc.Instance}}"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
