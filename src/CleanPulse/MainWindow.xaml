<Window x:Class="CleanPulse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CleanPulse.Localization"
        xmlns:vm="clr-namespace:CleanPulse.ViewModels"
        Title="CleanPulse"
        Width="1280"
        Height="820"
        MinWidth="1040"
        MinHeight="690"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico"
        Background="{DynamicResource WindowBgBrush}">

    <Grid Background="{DynamicResource WindowBgBrush}">
        <!-- Atmospheric Silver-White Studio Layer Behind Liquid Glass (Zero Neon) -->
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Canvas.Left="-140" Canvas.Top="-160" Width="660" Height="660" Fill="{DynamicResource AmbientOrbBrush1}"/>
            <Ellipse Canvas.Left="520" Canvas.Top="-80" Width="760" Height="760" Fill="{DynamicResource AmbientOrbBrush2}"/>
            <Ellipse Canvas.Left="180" Canvas.Top="390" Width="620" Height="620" Fill="{DynamicResource AmbientOrbBrush3}"/>
            <!-- Subtle Architectural Futuristic Glass Rings -->
            <Ellipse Canvas.Left="760" Canvas.Top="-190" Width="680" Height="680"
                     Stroke="{DynamicResource GlassBorderBrush}" StrokeThickness="1" Opacity="0.45"/>
            <Ellipse Canvas.Left="840" Canvas.Top="-110" Width="520" Height="520"
                     Stroke="{DynamicResource GlassBorderBrush}" StrokeThickness="1" Opacity="0.32"/>
        </Canvas>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Floating Frosted Glass Sidebar -->
            <Border Grid.Column="0"
                    Margin="16,16,0,16"
                    CornerRadius="22"
                    Background="{DynamicResource SidebarBgBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}"
                    BorderThickness="1.1"
                    Padding="14,18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.08" Color="{DynamicResource GlassShadowColor}"/>
                </Border.Effect>

                <DockPanel LastChildFill="True">

                    <!-- Brand Header -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,2,4,20">
                        <Border Width="40" Height="40" CornerRadius="13"
                                Background="{DynamicResource AccentBrush}"
                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="1"
                                Margin="0,0,12,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.16" Color="{DynamicResource GlassShadowColor}"/>
                            </Border.Effect>
                            <Path Data="M 5,19 L 11,19 L 15,8 L 19,28 L 24,15 L 27,19 L 33,19"
                                  Stroke="{DynamicResource AccentForegroundBrush}"
                                  StrokeThickness="2.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding [app_name], Source={x:Static loc:Loc.Instance}}"
                                       FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{Binding [app_tagline], Source={x:Static loc:Loc.Instance}}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Bottom Glass Status Cards -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Border Style="{StaticResource GlassSubCardStyle}"
                                Padding="12"
                                Margin="0,0,0,10"
                                DataContext="{Binding PrimaryDrive}"
                                Visibility="{Binding Converter={StaticResource NullToVis}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="{Binding [drive_system_disk], Source={x:Static loc:Loc.Instance}}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding DriveName}"
                                               HorizontalAlignment="Right"
                                               FontWeight="SemiBold"
                                               FontSize="12"/>
                                </Grid>
                                <ProgressBar Style="{StaticResource ModernProgressBarStyle}"
                                             Maximum="100"
                                             Value="{Binding UsedPercentage, Mode=OneWay}"
                                             Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding FreeSummaryText}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GlassSubCardStyle}" Padding="12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource WarningFgBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAdministrator}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource SuccessFgBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding PrivilegeStatusText}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="{Binding [privilege_elevate_hint], Source={x:Static loc:Loc.Instance}}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding IsStandardUser, Converter={StaticResource BoolToVis}}"
                                           Margin="0,2,0,8"/>
                                <Button Content="{Binding [privilege_elevate], Source={x:Static loc:Loc.Instance}}"
                                        Command="{Binding RestartAsAdminCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,6"
                                        FontSize="12"
                                        Visibility="{Binding IsStandardUser, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Navigation Capsule Pills -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel VerticalAlignment="Top">
                            <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                         GroupName="MainNav"
                                         IsChecked="{Binding ActiveSection, Converter={StaticResource EnumEqBool}, ConverterParameter=Cleaner}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 12,2 L 15,9 L 22,12 L 15,15 L 12,22 L 9,15 L 2,12 L 9,9 Z"
                                          Width="16" Height="16" Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding [nav_cleaner], Source={x:Static loc:Loc.Instance}}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                         GroupName="MainNav"
                                         IsChecked="{Binding ActiveSection, Converter={StaticResource EnumEqBool}, ConverterParameter=Analyzer}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 12,2 A 10,10 0 1 0 22,12 H 12 Z M 14,2.3 A 10,10 0 0 1 21.7,10 H 14 Z"
                                          Width="16" Height="16" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.8"
                                          Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding [nav_analyzer], Source={x:Static loc:Loc.Instance}}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                         GroupName="MainNav"
                                         IsChecked="{Binding ActiveSection, Converter={StaticResource EnumEqBool}, ConverterParameter=Duplicates}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 8,8 H 20 V 20 H 8 Z M 4,16 V 4 H 16"
                                          Width="16" Height="16" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.8"
                                          Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding [nav_duplicates], Source={x:Static loc:Loc.Instance}}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                         GroupName="MainNav"
                                         IsChecked="{Binding ActiveSection, Converter={StaticResource EnumEqBool}, ConverterParameter=Startup}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 13,2 L 4,14 H 12 L 11,22 L 20,10 H 12 Z"
                                          Width="16" Height="16" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.8"
                                          Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding [nav_startup], Source={x:Static loc:Loc.Instance}}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                         GroupName="MainNav"
                                         IsChecked="{Binding ActiveSection, Converter={StaticResource EnumEqBool}, ConverterParameter=Rules}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 12,2 L 20,6 V 12 C 20,17 16.5,20.5 12,22 C 7.5,20.5 4,17 4,12 V 6 Z"
                                          Width="16" Height="16" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.8"
                                          Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding [nav_rules], Source={x:Static loc:Loc.Instance}}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                         GroupName="MainNav"
                                         IsChecked="{Binding ActiveSection, Converter={StaticResource EnumEqBool}, ConverterParameter=Logs}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 4,5 H 20 M 4,12 H 20 M 4,19 H 14"
                                          Width="16" Height="16" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding [nav_logs], Source={x:Static loc:Loc.Instance}}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                         GroupName="MainNav"
                                         IsChecked="{Binding ActiveSection, Converter={StaticResource EnumEqBool}, ConverterParameter=Settings}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 12,8 A 4,4 0 1 0 12,16 A 4,4 0 1 0 12,8 Z M 19.4,15 A 1.65,1.65 0 0 0 19.7,16.8 L 19.8,16.9 A 2,2 0 0 1 17,19.7 L 16.9,19.6 A 1.65,1.65 0 0 0 15,19.9 A 1.65,1.65 0 0 0 14,21.4 V 21.6 A 2,2 0 0 1 10,21.6 V 21.4 A 1.65,1.65 0 0 0 9,19.9 A 1.65,1.65 0 0 0 7.2,19.6 L 7.1,19.7 A 2,2 0 0 1 4.3,16.9 L 4.4,16.8 A 1.65,1.65 0 0 0 4.1,15 A 1.65,1.65 0 0 0 2.6,14 H 2.4 A 2,2 0 0 1 2.4,10 H 2.6 A 1.65,1.65 0 0 0 4.1,9 A 1.65,1.65 0 0 0 4.4,7.2 L 4.3,7.1 A 2,2 0 0 1 7.1,4.3 L 7.2,4.4 A 1.65,1.65 0 0 0 9,4.1 A 1.65,1.65 0 0 0 10,2.6 V 2.4 A 2,2 0 0 1 14,2.4 V 2.6 A 1.65,1.65 0 0 0 15,4.1 A 1.65,1.65 0 0 0 16.8,4.4 L 16.9,4.3 A 2,2 0 0 1 19.7,7.1 L 19.6,7.2 A 1.65,1.65 0 0 0 19.9,9 A 1.65,1.65 0 0 0 21.4,10 H 21.6 A 2,2 0 0 1 21.6,14 H 21.4 A 1.65,1.65 0 0 0 19.9,15 Z"
                                          Width="16" Height="16" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.7"
                                          Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding [nav_settings], Source={x:Static loc:Loc.Instance}}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Main Workspace Content -->
            <Grid Grid.Column="1" Margin="18,16,18,16">

                <!-- SECTION 1: CLEANER -->
                <Grid Visibility="{Binding ActiveSection, Converter={StaticResource EnumEqVis}, ConverterParameter=Cleaner}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Liquid Glass Hero Action Card -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="20,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Futuristic Monochrome Glass Core Orb -->
                                <Grid Grid.Column="0" Width="54" Height="54" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <Border CornerRadius="27"
                                            Background="{DynamicResource CardElevatedBgBrush}"
                                            BorderBrush="{DynamicResource GlassBorderBrush}"
                                            BorderThickness="1.2"/>
                                    <Border Margin="6" CornerRadius="21"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            BorderBrush="{DynamicResource GlassBorderBrush}"
                                            BorderThickness="1">
                                        <Path Data="M 4,14 L 9,14 L 12,6 L 16,22 L 19,11 L 21,14 L 26,14"
                                              Width="24" Height="22" Stretch="Uniform"
                                              Stroke="{DynamicResource TextPrimaryBrush}"
                                              StrokeThickness="2.2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"/>
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding HeroTitle}"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding HeroSubtitle}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,3,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{Binding [btn_analyze], Source={x:Static loc:Loc.Instance}}"
                                            Command="{Binding AnalyzeCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,0,10,0"/>
                                    <Button Content="{Binding [btn_clean], Source={x:Static loc:Loc.Instance}}"
                                            Command="{Binding CleanCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"/>
                                    <Button Content="{Binding [btn_cancel], Source={x:Static loc:Loc.Instance}}"
                                            Command="{Binding CancelCommand}"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                            Margin="10,0,0,0"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="1"
                                        Margin="0,12,0,0"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                <ProgressBar Style="{StaticResource ModernProgressBarStyle}"
                                             Maximum="100"
                                             Value="{Binding ProgressPercent, Mode=OneWay}"/>
                                <TextBlock Text="{Binding CurrentScanPath}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,5,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="{Binding [btn_select_recommended], Source={x:Static loc:Loc.Instance}}"
                                        Command="{Binding SelectRecommendedCommand}"
                                        Style="{StaticResource ChipButtonStyle}"
                                        Margin="0,0,8,0"/>
                                <Button Content="{Binding [btn_select_all], Source={x:Static loc:Loc.Instance}}"
                                        Command="{Binding SelectAllCommand}"
                                        Style="{StaticResource ChipButtonStyle}"
                                        Margin="0,0,8,0"/>
                                <Button Content="{Binding [btn_select_none], Source={x:Static loc:Loc.Instance}}"
                                        Command="{Binding SelectNoneCommand}"
                                        Style="{StaticResource ChipButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- DISM WinSxS Maintenance Glass Strip -->
                    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" CornerRadius="16" Padding="18,11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding [dism_title], Source={x:Static loc:Loc.Instance}}"
                                           FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding [dism_desc], Source={x:Static loc:Loc.Instance}}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding DismStatusText}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Visibility="{Binding HasDismStatus, Converter={StaticResource BoolToVis}}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="{Binding [dism_run], Source={x:Static loc:Loc.Instance}}"
                                    Command="{Binding RunDismCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Split Categories + File Inspector -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" MinWidth="370"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*" MinWidth="330"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Grouped Categories Glass Panel -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="10">
                            <ListBox ItemsSource="{Binding CategoriesView}"
                                     SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           Margin="10,10,10,4"/>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Margin" Value="2"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="RowBd"
                                                            Background="Transparent"
                                                            BorderBrush="Transparent"
                                                            BorderThickness="1"
                                                            CornerRadius="12"
                                                            Padding="10,8">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="RowBd" Property="Background" Value="{DynamicResource CardHoverBgBrush}"/>
                                                            <Setter TargetName="RowBd" Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="RowBd" Property="Background" Value="{DynamicResource CardSelectedBgBrush}"/>
                                                            <Setter TargetName="RowBd" Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:CategoryItemViewModel}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      Style="{StaticResource ModernCheckBoxStyle}"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,4,0"/>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,10,0">
                                                <WrapPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="13.5"
                                                               FontWeight="SemiBold"/>
                                                    <Border Background="{DynamicResource WarningBgBrush}"
                                                            CornerRadius="6"
                                                            Padding="7,1.5"
                                                            Margin="6,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding ShowAdminBadge, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding [badge_admin], Source={x:Static loc:Loc.Instance}}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource WarningFgBrush}"/>
                                                    </Border>
                                                    <Border Background="{DynamicResource SecondarySoftBrush}"
                                                            CornerRadius="6"
                                                            Padding="7,1.5"
                                                            Margin="6,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding IsCaution, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding [badge_caution], Source={x:Static loc:Loc.Instance}}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource SecondaryAccentBrush}"/>
                                                    </Border>
                                                    <Border Background="{DynamicResource DangerBgBrush}"
                                                            CornerRadius="6"
                                                            Padding="7,1.5"
                                                            Margin="6,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding IsBrowserOpen, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding [badge_browser_open], Source={x:Static loc:Loc.Instance}}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource DangerFgBrush}"/>
                                                    </Border>
                                                    <Border Background="{DynamicResource AccentSoftBrush}"
                                                            BorderBrush="{DynamicResource GlassBorderBrush}"
                                                            BorderThickness="0.8"
                                                            CornerRadius="6"
                                                            Padding="7,1.5"
                                                            Margin="6,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding IsCustomRule, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding [badge_custom], Source={x:Static loc:Loc.Instance}}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    </Border>
                                                </WrapPanel>
                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SizeText}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Right">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCleaned}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessFgBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsAccessDenied}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerFgBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsAnalyzedWithItems}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryAccentBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding FileCountText}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!-- Right: Selected Category Glass Inspector -->
                        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16">
                            <Grid DataContext="{Binding SelectedCategory}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <StackPanel Grid.Row="0" Visibility="{Binding Converter={StaticResource NullToVis}}">
                                    <Grid>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,90,0"/>
                                        <Border Style="{StaticResource GlassSubCardStyle}"
                                                CornerRadius="8"
                                                Padding="9,3"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Border>
                                    </Grid>

                                    <Border Style="{StaticResource GlassSubCardStyle}"
                                            CornerRadius="12"
                                            Padding="11,8"
                                            Margin="0,9,0,9">
                                        <TextBlock Text="{Binding SafetyNote}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>

                                <!-- Target Paths -->
                                <StackPanel Grid.Row="1" Margin="0,0,0,9" Visibility="{Binding Converter={StaticResource NullToVis}}">
                                    <TextBlock Text="{Binding [inspector_targets], Source={x:Static loc:Loc.Instance}}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,0,0,4"/>
                                    <Border Style="{StaticResource GlassSubCardStyle}"
                                            CornerRadius="11"
                                            Padding="10,7"
                                            MaxHeight="74">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <TextBlock Text="{Binding TargetPathsText}"
                                                       FontFamily="Consolas"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"/>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>

                                <!-- Inspector Search & Segmented Sort Controls -->
                                <Grid Grid.Row="2" Margin="0,0,0,8" Visibility="{Binding Converter={StaticResource NullToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             Padding="9,6"
                                             FontSize="12"
                                             Text="{Binding InspectorFilterText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{Binding [inspector_search_hint], Source={x:Static loc:Loc.Instance}}"
                                             Margin="0,0,8,0"/>
                                    <Border Grid.Column="1" Style="{StaticResource SegmentedTrackStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="{Binding [inspector_sort_size], Source={x:Static loc:Loc.Instance}}"
                                                         IsChecked="{Binding IsSortSize, Mode=TwoWay}"
                                                         Style="{StaticResource SegmentedRadioButtonStyle}"
                                                         Padding="8,4" FontSize="11" GroupName="InspSort"/>
                                            <RadioButton Content="{Binding [inspector_sort_name], Source={x:Static loc:Loc.Instance}}"
                                                         IsChecked="{Binding IsSortName, Mode=TwoWay}"
                                                         Style="{StaticResource SegmentedRadioButtonStyle}"
                                                         Padding="8,4" FontSize="11" GroupName="InspSort"/>
                                            <RadioButton Content="{Binding [inspector_sort_date], Source={x:Static loc:Loc.Instance}}"
                                                         IsChecked="{Binding IsSortDate, Mode=TwoWay}"
                                                         Style="{StaticResource SegmentedRadioButtonStyle}"
                                                         Padding="8,4" FontSize="11" GroupName="InspSort"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Discovered Files List -->
                                <Grid Grid.Row="3" Visibility="{Binding Converter={StaticResource NullToVis}}">
                                    <ListBox ItemsSource="{Binding PreviewItems}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Padding" Value="7,5"/>
                                                <Setter Property="Margin" Value="0,1.5"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Bd"
                                                                    Background="Transparent"
                                                                    BorderBrush="Transparent"
                                                                    BorderThickness="0.8"
                                                                    CornerRadius="9"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBgBrush}"/>
                                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ScannedItemViewModel}">
                                                <Grid ToolTip="{Binding FullPath}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontSize="12"
                                                                   FontWeight="Medium"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding FullPath}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding SizeText}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Right"/>
                                                        <TextBlock Text="{Binding ModifiedText}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   HorizontalAlignment="Right"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding IsSpecialAction, Converter={StaticResource InvBoolToVis}}">
                                                        <Button Content="📁"
                                                                ToolTip="{Binding [inspector_open_folder], Source={x:Static loc:Loc.Instance}}"
                                                                Command="{Binding DataContext.OpenItemFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource ChipButtonStyle}"
                                                                Padding="6,2"
                                                                Margin="0,0,3,0"/>
                                                        <Button Content="♻"
                                                                ToolTip="{Binding [inspector_recycle_item], Source={x:Static loc:Loc.Instance}}"
                                                                Command="{Binding DataContext.RecycleScannedItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource ChipButtonStyle}"
                                                                Padding="6,2"
                                                                Margin="0,0,3,0"/>
                                                        <Button Content="✕"
                                                                ToolTip="{Binding [inspector_add_exclusion], Source={x:Static loc:Loc.Instance}}"
                                                                Command="{Binding DataContext.ExcludeItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource ChipButtonStyle}"
                                                                Padding="6,2"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <TextBlock Text="{Binding [inspector_no_files], Source={x:Static loc:Loc.Instance}}"
                                               FontSize="12.5"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               Margin="16">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PreviewItems.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <TextBlock Grid.Row="4"
                                           Text="{Binding TruncatedNoticeText}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,6,0,0"
                                           Visibility="{Binding ShowTruncatedNotice, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- SECTION 2: DISK ANALYZER -->
                <Grid DataContext="{Binding DiskAnalyzer}"
                      Visibility="{Binding DataContext.ActiveSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumEqVis}, ConverterParameter=Analyzer}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="4,2,0,0">
                        <TextBlock Text="{Binding [analyzer_title], Source={x:Static loc:Loc.Instance}}" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="{Binding [analyzer_subtitle], Source={x:Static loc:Loc.Instance}}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="16">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          Style="{StaticResource ModernComboBoxStyle}"
                                          ItemsSource="{Binding AvailableRoots}"
                                          Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          Margin="0,0,10,0"/>
                                <Button Grid.Column="1"
                                        Content="{Binding [analyzer_browse], Source={x:Static loc:Loc.Instance}}"
                                        Command="{Binding BrowseFolderCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,10,0"/>
                                <Button Grid.Column="2"
                                        Content="{Binding [analyzer_scan], Source={x:Static loc:Loc.Instance}}"
                                        Command="{Binding ScanCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"/>
                                <Button Grid.Column="3"
                                        Content="{Binding [btn_cancel], Source={x:Static loc:Loc.Instance}}"
                                        Command="{Binding CancelCommand}"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                        Margin="10,0,0,0"/>
                            </Grid>
                            <TextBlock Text="{Binding SummaryText}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding ProgressPath}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.85*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1.15*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Top Folders -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="14">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding [analyzer_folders_title], Source={x:Static loc:Loc.Instance}}" FontSize="14.5" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <ListBox ItemsSource="{Binding TopFolders}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Margin" Value="0,3"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border Style="{StaticResource GlassSubCardStyle}" Padding="11,8">
                                                            <ContentPresenter/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:FolderBarViewModel}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryAccentBrush}" Margin="8,0"/>
                                                    <Button Grid.Column="2" Content="🔍"
                                                            Command="{Binding DataContext.DrillDownFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource ChipButtonStyle}" Padding="6,2"/>
                                                </Grid>
                                                <ProgressBar Style="{StaticResource ModernProgressBarStyle}" Maximum="100" Value="{Binding PercentOfTotal, Mode=OneWay}" Height="5" Margin="0,0,0,5"/>
                                                <TextBlock Text="{Binding FileCountText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- Right: Top 150 Large Files -->
                        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="14">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding [analyzer_files_title], Source={x:Static loc:Loc.Instance}}" FontSize="14.5" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <Border Style="{StaticResource SegmentedTrackStyle}" HorizontalAlignment="Left">
                                        <WrapPanel>
                                            <RadioButton Content="{Binding [analyzer_filter_all], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding SelectedFilter, Converter={StaticResource EnumEqBool}, ConverterParameter=All}" Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="DiskFilter"/>
                                            <RadioButton Content="{Binding [analyzer_filter_archives], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding SelectedFilter, Converter={StaticResource EnumEqBool}, ConverterParameter=Archives}" Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="DiskFilter"/>
                                            <RadioButton Content="{Binding [analyzer_filter_images], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding SelectedFilter, Converter={StaticResource EnumEqBool}, ConverterParameter=DiskImages}" Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="DiskFilter"/>
                                            <RadioButton Content="{Binding [analyzer_filter_installers], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding SelectedFilter, Converter={StaticResource EnumEqBool}, ConverterParameter=Installers}" Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="DiskFilter"/>
                                            <RadioButton Content="{Binding [analyzer_filter_media], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding SelectedFilter, Converter={StaticResource EnumEqBool}, ConverterParameter=Media}" Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="DiskFilter"/>
                                            <RadioButton Content="{Binding [analyzer_filter_temp], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding SelectedFilter, Converter={StaticResource EnumEqBool}, ConverterParameter=TempAndDumps}" Style="{StaticResource SegmentedRadioButtonStyle}" GroupName="DiskFilter"/>
                                        </WrapPanel>
                                    </Border>
                                </StackPanel>

                                <ListBox ItemsSource="{Binding TopFiles}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Margin" Value="0,2.5"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border Style="{StaticResource GlassSubCardStyle}" Padding="10,7">
                                                            <ContentPresenter/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:LargeFileItemViewModel}">
                                            <Grid ToolTip="{Binding FullPath}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding DirectoryPath}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding SizeText}" FontWeight="Bold" FontSize="12.5" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding ModifiedText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="📁" Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Style="{StaticResource ChipButtonStyle}" Padding="6,3" Margin="0,0,4,0"/>
                                                    <Button Content="{Binding [analyzer_recycle], Source={x:Static loc:Loc.Instance}}" Command="{Binding DataContext.RecycleFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Style="{StaticResource ChipButtonStyle}" Padding="8,3" Margin="0,0,4,0" Visibility="{Binding IsProtectedOs, Converter={StaticResource InvBoolToVis}}"/>
                                                    <Button Content="✕" ToolTip="{Binding [analyzer_delete_perm], Source={x:Static loc:Loc.Instance}}" Command="{Binding DataContext.DeleteFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Style="{StaticResource ChipButtonStyle}" Padding="6,3" Visibility="{Binding IsProtectedOs, Converter={StaticResource InvBoolToVis}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- SECTION 3: DUPLICATE FINDER -->
                <Grid DataContext="{Binding DuplicateFinder}"
                      Visibility="{Binding DataContext.ActiveSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumEqVis}, ConverterParameter=Duplicates}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="4,2,0,0">
                        <TextBlock Text="{Binding [dup_title], Source={x:Static loc:Loc.Instance}}" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="{Binding [dup_subtitle], Source={x:Static loc:Loc.Instance}}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="16">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                                <Button Grid.Column="1" Content="{Binding [excl_browse_folder], Source={x:Static loc:Loc.Instance}}" Command="{Binding BrowseFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                                <ComboBox Grid.Column="2" Style="{StaticResource ModernComboBoxStyle}" ItemsSource="{Binding MinSizeOptions}" DisplayMemberPath="Label" SelectedValuePath="Bytes" SelectedValue="{Binding MinSizeBytes, Mode=TwoWay}" Margin="0,0,10,0"/>
                                <Button Grid.Column="3" Content="{Binding [dup_scan], Source={x:Static loc:Loc.Instance}}" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                                <Button Grid.Column="4" Content="{Binding [btn_cancel], Source={x:Static loc:Loc.Instance}}" Command="{Binding CancelCommand}" Style="{StaticResource DangerButtonStyle}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="10,0,0,0"/>
                            </Grid>
                            <TextBlock Text="{Binding SummaryText}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding ProgressPath}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0"/>

                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="{Binding [dup_select_copies], Source={x:Static loc:Loc.Instance}}" Command="{Binding SelectKeepOldestCommand}" Style="{StaticResource ChipButtonStyle}" Margin="0,0,8,0"/>
                                <Button Content="{Binding [dup_select_newest], Source={x:Static loc:Loc.Instance}}" Command="{Binding SelectKeepNewestCommand}" Style="{StaticResource ChipButtonStyle}" Margin="0,0,8,0"/>
                                <Button Content="{Binding [dup_clear_sel], Source={x:Static loc:Loc.Instance}}" Command="{Binding ClearSelectionCommand}" Style="{StaticResource ChipButtonStyle}" Margin="0,0,12,0"/>
                                <Button Content="{Binding [dup_recycle_selected], Source={x:Static loc:Loc.Instance}}" Command="{Binding RecycleSelectedCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="14,7" FontSize="12.5"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" Padding="14">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Groups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:DuplicateGroupViewModel}">
                                            <Border Style="{StaticResource GlassSubCardStyle}" Padding="13" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding HeaderText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                                    <ItemsControl ItemsSource="{Binding Files}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:DuplicateFileItemViewModel}">
                                                                <Grid Margin="0,3">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <CheckBox Grid.Column="0" Style="{StaticResource ModernCheckBoxStyle}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,6,0"/>
                                                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="12.5"/>
                                                                        <TextBlock Text="{Binding DirectoryPath}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="2" Text="{Binding ModifiedText}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                                    <Button Grid.Column="3" Content="📁" Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource ChipButtonStyle}" Padding="6,2"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock Text="{Binding [dup_empty], Source={x:Static loc:Loc.Instance}}" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasNoGroups, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- SECTION 4: STARTUP MANAGER -->
                <Grid DataContext="{Binding StartupManager}"
                      Visibility="{Binding DataContext.ActiveSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EnumEqVis}, ConverterParameter=Startup}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,2,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding [startup_title], Source={x:Static loc:Loc.Instance}}" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="{Binding [startup_subtitle], Source={x:Static loc:Loc.Instance}}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Content="{Binding [startup_refresh], Source={x:Static loc:Loc.Instance}}" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="14">
                        <StackPanel>
                            <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding [startup_filter_hint], Source={x:Static loc:Loc.Instance}}"/>
                            <TextBlock Text="{Binding [startup_admin_warn], Source={x:Static loc:Loc.Instance}}" FontSize="12" Foreground="{DynamicResource WarningFgBrush}" Visibility="{Binding ShowAdminWarning, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" Padding="14">
                        <Grid>
                            <ListBox ItemsSource="{Binding FilteredItems}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Margin" Value="0,3"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border Style="{StaticResource GlassSubCardStyle}" Padding="13,10">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:StartupItemViewModel}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" Style="{StaticResource IosToggleSwitchStyle}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" IsEnabled="{Binding CanToggle}" Margin="0,0,10,0"/>

                                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"/>
                                                    <Border Background="{DynamicResource SecondarySoftBrush}" CornerRadius="6" Padding="7,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ScopeBadge}" FontSize="10" Foreground="{DynamicResource SecondaryAccentBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Command}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding StateText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessFgBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <Button Grid.Column="3" Content="📁" Command="{Binding DataContext.OpenCommandLocationCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Style="{StaticResource ChipButtonStyle}" Padding="7,3"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="{Binding [startup_empty], Source={x:Static loc:Loc.Instance}}" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- SECTION 5: RULES & EXCLUSIONS -->
                <ScrollViewer Visibility="{Binding ActiveSection, Converter={StaticResource EnumEqVis}, ConverterParameter=Rules}" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,2,6,0">
                        <TextBlock Text="{Binding [rules_title], Source={x:Static loc:Loc.Instance}}" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="{Binding [rules_subtitle], Source={x:Static loc:Loc.Instance}}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,16"/>

                        <!-- Custom Cleanup Folders -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="{Binding [rules_custom_header], Source={x:Static loc:Loc.Instance}}" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding NewRuleName, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding [rules_name_hint], Source={x:Static loc:Loc.Instance}}"/>
                                    <TextBox Grid.Column="2" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding NewRulePath, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding [rules_path_hint], Source={x:Static loc:Loc.Instance}}"/>
                                    <TextBox Grid.Column="4" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding NewRulePattern, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding [rules_pattern_hint], Source={x:Static loc:Loc.Instance}}"/>
                                    <Button Grid.Column="6" Content="{Binding [excl_browse_folder], Source={x:Static loc:Loc.Instance}}" Command="{Binding BrowseCustomRuleFolderCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                                </Grid>

                                <WrapPanel Margin="0,0,0,10">
                                    <CheckBox Style="{StaticResource IosToggleSwitchStyle}" IsChecked="{Binding NewRuleRecursive}" Content="{Binding [rules_recursive], Source={x:Static loc:Loc.Instance}}" Margin="0,0,20,6"/>
                                    <CheckBox Style="{StaticResource IosToggleSwitchStyle}" IsChecked="{Binding NewRuleRespectAge}" Content="{Binding [rules_respect_age], Source={x:Static loc:Loc.Instance}}" Margin="0,0,20,6"/>
                                    <CheckBox Style="{StaticResource IosToggleSwitchStyle}" IsChecked="{Binding NewRuleToRecycle}" Content="{Binding [rules_to_recycle], Source={x:Static loc:Loc.Instance}}" Margin="0,0,20,6"/>
                                    <Button Content="{Binding [rules_add_btn], Source={x:Static loc:Loc.Instance}}" Command="{Binding AddCustomRuleCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="16,7" FontSize="12.5"/>
                                </WrapPanel>

                                <TextBlock Text="{Binding RuleValidationError}" Foreground="{DynamicResource DangerFgBrush}" FontSize="12" Visibility="{Binding HasRuleValidationError, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8"/>

                                <ItemsControl ItemsSource="{Binding CustomRules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource GlassSubCardStyle}" Padding="12,8" Margin="0,3">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                                        <TextBlock FontFamily="Consolas" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}">
                                                            <Run Text="{Binding FolderPath}"/>
                                                            <Run Text="  ("/>
                                                            <Run Text="{Binding SearchPattern}"/>
                                                            <Run Text=")"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Button Content="{Binding [excl_remove], Source={x:Static loc:Loc.Instance}}"
                                                            Command="{Binding DataContext.RemoveCustomRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource ChipButtonStyle}"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding [rules_custom_empty], Source={x:Static loc:Loc.Instance}}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5" Visibility="{Binding HasNoCustomRules, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Exclusions -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="18">
                            <StackPanel>
                                <TextBlock Text="{Binding [excl_title], Source={x:Static loc:Loc.Instance}}" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="{Binding [excl_subtitle], Source={x:Static loc:Loc.Instance}}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding NewExclusionInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding [excl_placeholder], Source={x:Static loc:Loc.Instance}}" Margin="0,0,10,0"/>
                                    <Button Grid.Column="1" Content="{Binding [excl_add], Source={x:Static loc:Loc.Instance}}" Command="{Binding AddExclusionCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0"/>
                                    <Button Grid.Column="2" Content="{Binding [excl_browse_folder], Source={x:Static loc:Loc.Instance}}" Command="{Binding BrowseExclusionFolderCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Exclusions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource GlassSubCardStyle}" Padding="12,8" Margin="0,3">
                                                <Grid>
                                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12.5" VerticalAlignment="Center"/>
                                                    <Button Content="{Binding [excl_remove], Source={x:Static loc:Loc.Instance}}"
                                                            Command="{Binding DataContext.RemoveExclusionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource ChipButtonStyle}"
                                                            HorizontalAlignment="Right"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding [excl_empty], Source={x:Static loc:Loc.Instance}}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5" Visibility="{Binding HasNoExclusions, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- SECTION 6: LOGS / HISTORY -->
                <Grid Visibility="{Binding ActiveSection, Converter={StaticResource EnumEqVis}, ConverterParameter=Logs}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,2,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding [logs_title], Source={x:Static loc:Loc.Instance}}" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="{Binding LogsSubtitleText}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="{Binding [logs_export], Source={x:Static loc:Loc.Instance}}" Command="{Binding ExportLogsCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>
                            <Button Content="{Binding [logs_clear], Source={x:Static loc:Loc.Instance}}" Command="{Binding ClearLogsCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="14">
                        <Grid>
                            <ListView ItemsSource="{Binding HistoryRows}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="12,9"/>
                                        <Setter Property="Margin" Value="0,2.5"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border Style="{StaticResource GlassSubCardStyle}" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:HistoryRowViewModel}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="155"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding TimestampText}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                                            <Border Grid.Column="1" CornerRadius="7" Padding="9,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource SecondarySoftBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCleanAction}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding ActionLabel}" FontSize="12" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryAccentBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCleanAction}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessFgBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding FilesText}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding DurationText}" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <TextBlock Text="{Binding [logs_empty], Source={x:Static loc:Loc.Instance}}" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasNoHistory, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- SECTION 7: SETTINGS -->
                <ScrollViewer Visibility="{Binding ActiveSection, Converter={StaticResource EnumEqVis}, ConverterParameter=Settings}" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,2,6,0">
                        <TextBlock Text="{Binding [settings_title], Source={x:Static loc:Loc.Instance}}" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="{Binding [settings_subtitle], Source={x:Static loc:Loc.Instance}}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,18"/>

                        <!-- Appearance & Language Segmented Glass Controls -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="18" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding [settings_language], Source={x:Static loc:Loc.Instance}}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <Border Style="{StaticResource SegmentedTrackStyle}" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="Русский" IsChecked="{Binding IsRussian, Mode=TwoWay}" Style="{StaticResource SegmentedRadioButtonStyle}" Padding="16,7" GroupName="LangGroup"/>
                                            <RadioButton Content="English" IsChecked="{Binding IsEnglish, Mode=TwoWay}" Style="{StaticResource SegmentedRadioButtonStyle}" Padding="16,7" GroupName="LangGroup"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding [settings_theme], Source={x:Static loc:Loc.Instance}}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <Border Style="{StaticResource SegmentedTrackStyle}" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="{Binding [settings_theme_light], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding IsLightTheme, Mode=TwoWay}" Style="{StaticResource SegmentedRadioButtonStyle}" Padding="16,7" GroupName="ThemeGroup"/>
                                            <RadioButton Content="{Binding [settings_theme_dark], Source={x:Static loc:Loc.Instance}}" IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" Style="{StaticResource SegmentedRadioButtonStyle}" Padding="16,7" GroupName="ThemeGroup"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Safety & Automation -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="18" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding [settings_min_age], Source={x:Static loc:Loc.Instance}}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding [settings_min_age_desc], Source={x:Static loc:Loc.Instance}}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,10"/>
                                <ComboBox Style="{StaticResource ModernComboBoxStyle}" ItemsSource="{Binding AgeOptions}" DisplayMemberPath="Label" SelectedValuePath="Hours" SelectedValue="{Binding MinimumFileAgeHours, Mode=TwoWay}" Width="330" HorizontalAlignment="Left" Margin="0,0,0,16"/>

                                <CheckBox Style="{StaticResource IosToggleSwitchStyle}" IsChecked="{Binding ConfirmBeforeClean, Mode=TwoWay}" Content="{Binding [settings_confirm_clean], Source={x:Static loc:Loc.Instance}}" Margin="0,0,0,12"/>
                                <CheckBox Style="{StaticResource IosToggleSwitchStyle}" IsChecked="{Binding AutoAnalyzeOnStartup, Mode=TwoWay}" Content="{Binding [settings_auto_analyze], Source={x:Static loc:Loc.Instance}}" Margin="0,0,0,18"/>

                                <TextBlock Text="{Binding [settings_schedule], Source={x:Static loc:Loc.Instance}}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding [settings_schedule_desc], Source={x:Static loc:Loc.Instance}}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,10"/>
                                <ComboBox Style="{StaticResource ModernComboBoxStyle}" ItemsSource="{Binding ScheduleOptions}" DisplayMemberPath="Label" SelectedValuePath="Frequency" SelectedValue="{Binding ScheduledCleanFrequency, Mode=TwoWay}" Width="330" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <!-- Local Drives Overview -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="18" Margin="0,0,0,14">
                            <ItemsControl ItemsSource="{Binding Drives}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DriveTileViewModel}">
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="210"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontWeight="SemiBold">
                                                <Run Text="{Binding DriveName, Mode=OneWay}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding VolumeLabel, Mode=OneWay}" Foreground="{DynamicResource TextMutedBrush}"/>
                                            </TextBlock>
                                            <ProgressBar Grid.Column="1" Style="{StaticResource ModernProgressBarStyle}" Maximum="100" Value="{Binding UsedPercentage, Mode=OneWay}" VerticalAlignment="Center" Margin="14,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding FreeSummaryText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- CLI & Security Guarantees -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="18" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding [settings_cli_title], Source={x:Static loc:Loc.Instance}}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <Border Style="{StaticResource GlassSubCardStyle}" Padding="12,9" Margin="0,0,0,14">
                                    <TextBlock Text="{Binding [settings_cli_body], Source={x:Static loc:Loc.Instance}}" FontFamily="Consolas" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                </Border>

                                <TextBlock Text="{Binding [settings_security_title], Source={x:Static loc:Loc.Instance}}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding [settings_security_body], Source={x:Static loc:Loc.Instance}}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="20"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Padding="18">
                            <StackPanel>
                                <TextBlock Text="{Binding [settings_about_title], Source={x:Static loc:Loc.Instance}}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding [settings_about_body], Source={x:Static loc:Loc.Instance}}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
