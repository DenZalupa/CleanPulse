<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>CleanPulse</AssemblyName>
    <RootNamespace>CleanPulse</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>DanZalupa</Authors>
    <Product>CleanPulse</Product>
    <Description>Local Windows System and Temp Cleaner built with .NET 9 WPF</Description>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CleanPulse.Core\CleanPulse.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>
</Project>
