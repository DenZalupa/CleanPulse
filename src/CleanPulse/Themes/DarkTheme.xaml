<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Smoked Obsidian Liquid Glass Backdrop (No Neon) -->
    <LinearGradientBrush x:Key="WindowBgBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#12151B" Offset="0.0"/>
        <GradientStop Color="#1A1E26" Offset="0.5"/>
        <GradientStop Color="#0F1218" Offset="1.0"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="AmbientOrbBrush1" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#22FFFFFF" Offset="0.0"/>
        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AmbientOrbBrush2" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#1C94A3B8" Offset="0.0"/>
        <GradientStop Color="#0094A3B8" Offset="1.0"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AmbientOrbBrush3" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#16CBD5E1" Offset="0.0"/>
        <GradientStop Color="#00CBD5E1" Offset="1.0"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="SidebarBgBrush" StartPoint="0,0" EndPoint="0.3,1">
        <GradientStop Color="#9A202530" Offset="0.0"/>
        <GradientStop Color="#7A171B24" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardBgBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#90252B37" Offset="0.0"/>
        <GradientStop Color="#761C212B" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardElevatedBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#8E2B3240" Offset="0.0"/>
        <GradientStop Color="#76222834" Offset="1.0"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="CardHoverBgBrush" Color="#9A303848"/>
    <SolidColorBrush x:Key="CardSelectedBgBrush" Color="#B0353E50"/>
    <SolidColorBrush x:Key="InputBgBrush" Color="#88171B23"/>
    <SolidColorBrush x:Key="SegmentedTrackBrush" Color="#550E1117"/>

    <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#44FFFFFF" Offset="0.0"/>
        <GradientStop Color="#18FFFFFF" Offset="0.4"/>
        <GradientStop Color="#0CFFFFFF" Offset="0.75"/>
        <GradientStop Color="#2CFFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassTopSheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1AFFFFFF" Offset="0.0"/>
        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="#CBD5E1"/>
    <Color x:Key="GlassShadowColor">#000000</Color>

    <!-- Frosted Platinum Accents -->
    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F3F6FA" Offset="0.0"/>
        <GradientStop Color="#D7DEE8" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0.0"/>
        <GradientStop Color="#E5EAF2" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AccentSolidBrush" Color="#E6ECF4"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#11151C"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#26FFFFFF"/>

    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="SecondarySoftBrush" Color="#1CFFFFFF"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1F4F9"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A3AEBF"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#727D90"/>

    <SolidColorBrush x:Key="WarningBgBrush" Color="#383022"/>
    <SolidColorBrush x:Key="WarningFgBrush" Color="#E6BA6E"/>
    <SolidColorBrush x:Key="DangerBgBrush" Color="#3C2229"/>
    <SolidColorBrush x:Key="DangerFgBrush" Color="#E88B9A"/>
    <SolidColorBrush x:Key="SuccessBgBrush" Color="#1D362D"/>
    <SolidColorBrush x:Key="SuccessFgBrush" Color="#74C6A3"/>

    <SolidColorBrush x:Key="ToggleOffTrackBrush" Color="#38FFFFFF"/>
    <SolidColorBrush x:Key="ToggleKnobBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#38FFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#55FFFFFF"/>
</ResourceDictionary>
