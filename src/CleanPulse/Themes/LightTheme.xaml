<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Silver-White Futuristic Liquid Glass Backdrop -->
    <LinearGradientBrush x:Key="WindowBgBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E8ECF2" Offset="0.0"/>
        <GradientStop Color="#F6F8FB" Offset="0.48"/>
        <GradientStop Color="#E2E7EF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Soft Monochrome Ambient Light Clouds Behind Glass -->
    <RadialGradientBrush x:Key="AmbientOrbBrush1" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
        <GradientStop Color="#88FFFFFF" Offset="0.45"/>
        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AmbientOrbBrush2" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#CCCDD4DF" Offset="0.0"/>
        <GradientStop Color="#55D7DDE7" Offset="0.55"/>
        <GradientStop Color="#00D7DDE7" Offset="1.0"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AmbientOrbBrush3" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#B8BFC8D6" Offset="0.0"/>
        <GradientStop Color="#00BFC8D6" Offset="1.0"/>
    </RadialGradientBrush>

    <!-- Translucent Liquid Glass Surfaces -->
    <LinearGradientBrush x:Key="SidebarBgBrush" StartPoint="0,0" EndPoint="0.3,1">
        <GradientStop Color="#CCFFFFFF" Offset="0.0"/>
        <GradientStop Color="#96F1F4F8" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardBgBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D6FFFFFF" Offset="0.0"/>
        <GradientStop Color="#A8F5F7FA" Offset="0.55"/>
        <GradientStop Color="#9CEBF0F6" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardElevatedBgBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CCFFFFFF" Offset="0.0"/>
        <GradientStop Color="#A4EEF2F7" Offset="1.0"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="CardHoverBgBrush" Color="#E8FFFFFF"/>
    <SolidColorBrush x:Key="CardSelectedBgBrush" Color="#F7FFFFFF"/>
    <SolidColorBrush x:Key="InputBgBrush" Color="#C8FFFFFF"/>
    <SolidColorBrush x:Key="SegmentedTrackBrush" Color="#18202B3A"/>

    <!-- Specular Glass Rim (45deg White-to-Silver Edge) -->
    <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FAFFFFFF" Offset="0.0"/>
        <GradientStop Color="#88FFFFFF" Offset="0.35"/>
        <GradientStop Color="#3C8E99AA" Offset="0.72"/>
        <GradientStop Color="#D8FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassTopSheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B8FFFFFF" Offset="0.0"/>
        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#559AA4B4"/>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="#3E4756"/>
    <Color x:Key="GlassShadowColor">#1E2633</Color>

    <!-- Anodized Titanium Graphite Accents (Zero Neon) -->
    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2C3340" Offset="0.0"/>
        <GradientStop Color="#161B22" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3B4352" Offset="0.0"/>
        <GradientStop Color="#222833" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AccentSolidBrush" Color="#1F252F"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#F0FFFFFF"/>

    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="#3E4756"/>
    <SolidColorBrush x:Key="SecondarySoftBrush" Color="#143E4756"/>

    <!-- Typography -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#14181F"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#535D6E"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8892A3"/>

    <!-- Muted Mineral Status Tones (No Neon) -->
    <SolidColorBrush x:Key="WarningBgBrush" Color="#DDF6ECDA"/>
    <SolidColorBrush x:Key="WarningFgBrush" Color="#8A5C18"/>
    <SolidColorBrush x:Key="DangerBgBrush" Color="#DDF6E3E6"/>
    <SolidColorBrush x:Key="DangerFgBrush" Color="#9E3446"/>
    <SolidColorBrush x:Key="SuccessBgBrush" Color="#DDDCECE5"/>
    <SolidColorBrush x:Key="SuccessFgBrush" Color="#24634C"/>

    <SolidColorBrush x:Key="ToggleOffTrackBrush" Color="#3A64748B"/>
    <SolidColorBrush x:Key="ToggleKnobBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#558B95A5"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#88647082"/>
</ResourceDictionary>
